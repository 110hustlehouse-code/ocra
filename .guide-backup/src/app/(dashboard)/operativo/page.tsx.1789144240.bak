"use client";

import * as React from "react";
import { useStore } from "@/lib/demo/store";
import { eur, eur2, dayMonth, dateIt, daysFromToday, TODAY, generatePoCode, services } from "@/lib/demo/data";
import { Badge, Panel, PageHead, Empty } from "@/components/ui/kit";
import { useToast } from "@/components/ui/toast";
import { RitenutaCalc } from "@/components/compliance/compliance-panel";
import { Accordion } from "@/components/ui/accordion";

type Filter = "tutte" | "entrate" | "uscite" | "scadute";

export default function OperativoPage() {
  const s = useStore();
  const toast = useToast();
  const [filter, setFilter] = React.useState<Filter>("tutte");

  const entrate = s.invoices.filter((i) => i.direction === "E");
  const uscite = s.invoices.filter((i) => i.direction === "U");
  const daIncassare = entrate.filter((i) => i.status !== "paid").reduce((a, i) => a + i.amount, 0);
  const daPagare = uscite.filter((i) => i.status !== "paid").reduce((a, i) => a + i.amount, 0);
  const incassato = entrate.filter((i) => i.status === "paid").reduce((a, i) => a + i.amount, 0);
  const scadute = s.invoices.filter((i) => i.status === "overdue");

  const rows = s.invoices
    .filter((i) =>
      filter === "tutte" ? true
      : filter === "entrate" ? i.direction === "E"
      : filter === "uscite" ? i.direction === "U"
      : i.status === "overdue"
    )
    .sort((a, b) => +new Date(a.dueDate) - +new Date(b.dueDate));

  return (
    <div className="rise">
      <PageHead
        title="Operativo"
        sub="Scadenziario, codici PO e flussi di cassa previsti"
        actions={<button className="btn btn-primary" onClick={() => toast("Registrazione documento in arrivo nella prossima versione", "warn")}>+ Registra documento</button>}
      />

      <div className="grid grid-cols-2 xl:grid-cols-4 gap-4 mb-5" data-guide="operativo-kpi">
        {[
          ["Incassato", eur(incassato), "anno in corso", undefined],
          ["Da incassare", eur(daIncassare), `${entrate.filter((i) => i.status !== "paid").length} fatture aperte`, undefined],
          ["Da pagare", eur(daPagare), `${uscite.filter((i) => i.status !== "paid").length} documenti passivi`, undefined],
          ["Scaduto", eur(scadute.reduce((a, i) => a + i.amount, 0)), `${scadute.length} posizioni`, "danger"],
        ].map(([l, v, sub, tone]) => (
          <div key={l as string} className="card card-pad">
            <div className="t-label">{l as string}</div>
            <div className="t-num mt-2" style={tone ? { color: "var(--danger)" } : undefined}>{v as string}</div>
            <div className="t-meta mt-1">{sub as string}</div>
          </div>
        ))}
      </div>

      <div className="grid grid-cols-1 xl:grid-cols-[1fr_360px] gap-5 items-start">
        <div className="space-y-5">
          <div data-guide="operativo-scadenziario">
          <Panel
            title="Scadenziario"
            action={
              <div className="flex gap-1">
                {(["tutte", "entrate", "uscite", "scadute"] as Filter[]).map((f) => (
                  <button
                    key={f}
                    onClick={() => setFilter(f)}
                    className="btn btn-sm"
                    style={{
                      background: filter === f ? "var(--ink)" : "transparent",
                      color: filter === f ? "#fff" : "var(--text-2)",
                      border: filter === f ? "none" : "1px solid var(--line)",
                    }}
                  >
                    {f}
                  </button>
                ))}
              </div>
            }
          >
            {rows.length === 0 ? (
              <Empty title="Nessun documento in questa vista" />
            ) : (
              <div className="scroll-x">
                <table className="tbl tbl-compact">
                  <thead>
                    <tr>
                      <th></th><th>Controparte</th><th className="hide-lg">Descrizione</th><th className="hide-lg">Codice PO</th>
                      <th>Scadenza</th><th className="text-right">Importo</th><th>Stato</th><th></th>
                    </tr>
                  </thead>
                  <tbody>
                    {rows.map((i) => {
                      const gap = daysFromToday(i.dueDate);
                      return (
                        <tr key={i.id}>
                          <td style={{ width: 28 }}>
                            <span
                              className="inline-flex items-center justify-center w-5 h-5 rounded-[6px] text-[10px] font-semibold"
                              style={{
                                background: i.direction === "E" ? "var(--ok-soft)" : "var(--surface-2)",
                                color: i.direction === "E" ? "var(--ok)" : "var(--text-2)",
                              }}
                            >
                              {i.direction}
                            </span>
                          </td>
                          <td className="font-medium">{i.counterpart}</td>
                          <td className="hide-lg" style={{ color: "var(--text-2)" }}>{i.description}</td>
                          <td className="hide-lg t-meta tabular">{i.poCode}</td>
                          <td>
                            <span className="tabular" style={{ color: i.status === "overdue" ? "var(--danger)" : "var(--text-2)" }}>
                              {dayMonth(i.dueDate)}
                            </span>
                            {i.status !== "paid" && (
                              <span className="t-meta ml-1.5">{gap < 0 ? `+${-gap}g` : `${gap}g`}</span>
                            )}
                          </td>
                          <td className="text-right tabular font-medium">{eur2(i.amount)}</td>
                          <td>
                            {i.status === "paid" ? <Badge tone="ok" dot>{i.direction === "E" ? "Incassata" : "Pagata"}</Badge>
                             : i.status === "overdue" ? <Badge tone="danger" dot>Scaduta</Badge>
                             : <Badge tone="warn" dot>In attesa</Badge>}
                          </td>
                          <td className="text-right">
                            {i.status !== "paid" && (
                              <button className="btn btn-ghost btn-sm" onClick={() => s.markPaid(i.id)}>
                                Segna {i.direction === "E" ? "incassata" : "pagata"}
                              </button>
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}
          </Panel>
          </div>

          <div data-guide="operativo-cashflow">
          <Cashflow invoices={s.invoices} />
          </div>
        </div>

        <div className="space-y-5">
          <div data-guide="operativo-solleciti">
          <Solleciti />
          </div>
          <div data-guide="operativo-po">
          <PoGenerator />
          </div>
          <Accordion title="Ritenuta d'acconto" dataGuide="operativo-ritenuta">
            <RitenutaCalc />
          </Accordion>
        </div>
      </div>
    </div>
  );
}

/* ── Previsione di cassa a 8 settimane ── */
function Cashflow({ invoices }: { invoices: ReturnType<typeof useStore>["invoices"] }) {
  const weeks = Array.from({ length: 8 }, (_, w) => {
    const from = new Date(TODAY.getTime() + w * 7 * 864e5);
    const to = new Date(from.getTime() + 7 * 864e5);
    const inRange = invoices.filter((i) => {
      const d = new Date(i.dueDate);
      return i.status !== "paid" && d >= from && d < to;
    });
    return {
      label: dayMonth(from.toISOString()),
      inn: inRange.filter((i) => i.direction === "E").reduce((a, i) => a + i.amount, 0),
      out: inRange.filter((i) => i.direction === "U").reduce((a, i) => a + i.amount, 0),
    };
  });

  const max = Math.max(1, ...weeks.map((w) => Math.max(w.inn, w.out)));
  const netto = weeks.reduce((a, w) => a + w.inn - w.out, 0);

  return (
    <Panel
      title="Previsione di cassa · 8 settimane"
      action={
        <span className="text-[12px] font-medium tabular" style={{ color: netto >= 0 ? "var(--ok)" : "var(--danger)" }}>
          Saldo previsto {netto >= 0 ? "+" : ""}{eur(netto)}
        </span>
      }
    >
      <div className="px-5 py-5">
        <div className="flex items-end gap-2.5 h-[140px]">
          {weeks.map((w) => (
            <div key={w.label} className="flex-1 flex flex-col justify-end items-center gap-1 h-full">
              <div className="flex items-end gap-1 w-full h-full justify-center">
                <div
                  className="w-1/2 rounded-t-[3px] transition-all"
                  style={{ height: `${(w.inn / max) * 100}%`, background: "var(--ok)", minHeight: w.inn ? 3 : 0 }}
                  title={`Entrate ${eur(w.inn)}`}
                />
                <div
                  className="w-1/2 rounded-t-[3px] transition-all"
                  style={{ height: `${(w.out / max) * 100}%`, background: "var(--line)", minHeight: w.out ? 3 : 0 }}
                  title={`Uscite ${eur(w.out)}`}
                />
              </div>
              <span className="t-meta">{w.label}</span>
            </div>
          ))}
        </div>
        <div className="flex items-center gap-4 mt-4">
          <span className="inline-flex items-center gap-1.5 t-meta">
            <span className="w-2.5 h-2.5 rounded-[3px]" style={{ background: "var(--ok)" }} /> Entrate attese
          </span>
          <span className="inline-flex items-center gap-1.5 t-meta">
            <span className="w-2.5 h-2.5 rounded-[3px]" style={{ background: "var(--line)" }} /> Uscite previste
          </span>
        </div>
      </div>
    </Panel>
  );
}

/* ── Solleciti automatici ── */
function Solleciti() {
  const s = useStore();
  const toast = useToast();
  const overdue = s.invoices.filter((i) => i.direction === "E" && i.status === "overdue");

  return (
    <Panel title="Solleciti" action={<Badge tone="brand">automatico</Badge>}>
      <div className="px-5 py-4">
        {overdue.length === 0 ? (
          <div className="t-meta">Nessun insoluto. Niente da sollecitare.</div>
        ) : (
          <>
            {overdue.map((i) => (
              <div key={i.id} className="py-2.5 border-b last:border-0" style={{ borderColor: "var(--line-2)" }}>
                <div className="text-[12.5px] font-medium">{i.counterpart}</div>
                <div className="t-meta">
                  {eur2(i.amount)} · scaduta il {dateIt(i.dueDate)} · {-daysFromToday(i.dueDate)} giorni
                </div>
                <button className="btn btn-ghost btn-sm mt-2" onClick={() => toast(`Sollecito inviato a ${i.counterpart}`)}>Invia sollecito cortese</button>
              </div>
            ))}
            <p className="t-meta mt-3 leading-relaxed">
              Il primo sollecito parte da solo a 7 giorni dalla scadenza, il secondo a 21 con il
              responsabile in copia. Il testo si può rivedere prima dell&apos;invio.
            </p>
          </>
        )}
      </div>
    </Panel>
  );
}

/* ── Generatore di codice PO ── */
function PoGenerator() {
  const s = useStore();
  const [svc, setSvc] = React.useState(services[0].name);
  const [client, setClient] = React.useState(s.clients[0]?.companyName ?? "");
  const [dir, setDir] = React.useState<"E" | "U">("E");
  const n = s.invoices.length + 1;
  const code = generatePoCode(svc, n, new Date().getFullYear(), client || "CLIENTE", dir);

  return (
    <Panel title="Codice PO">
      <div className="card-pad space-y-3">
        <div>
          <label className="lbl">Servizio</label>
          <select className="field" value={svc} onChange={(e) => setSvc(e.target.value)}>
            {services.map((x) => <option key={x.id}>{x.name}</option>)}
          </select>
        </div>
        <div>
          <label className="lbl">Cliente</label>
          <input className="field" value={client} onChange={(e) => setClient(e.target.value)} />
        </div>
        <div>
          <label className="lbl">Direzione</label>
          <div className="flex gap-2">
            {(["E", "U"] as const).map((d) => (
              <button
                key={d}
                onClick={() => setDir(d)}
                className="btn btn-sm flex-1"
                style={{
                  background: dir === d ? "var(--ink)" : "var(--surface)",
                  color: dir === d ? "#fff" : "var(--text-2)",
                  border: "1px solid var(--line)",
                }}
              >
                {d === "E" ? "Entrata" : "Uscita"}
              </button>
            ))}
          </div>
        </div>
        <div className="rounded-[9px] px-3 py-2.5" style={{ background: "var(--surface-2)" }}>
          <div className="t-label mb-1">Codice generato</div>
          <div className="text-[12px] tabular font-medium break-all">{code}</div>
        </div>
        <button
          className="btn btn-ghost w-full"
          onClick={() => navigator.clipboard?.writeText(code)}
        >
          Copia codice
        </button>
      </div>
    </Panel>
  );
}
